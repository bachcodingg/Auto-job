{
  "cv_path": "CV_VoGiaBach (1).docx",
  "output_dir": "output",
  "db_path": "output/jobs.sqlite",

  "cities": {
    "Helsinki": {"linkedin": "Helsinki, Uusimaa, Finland", "duunitori": "helsinki", "match": ["helsinki", "helsingfors"]},
    "Espoo":    {"linkedin": "Espoo, Uusimaa, Finland",    "duunitori": "espoo",    "match": ["espoo", "esbo", "otaniemi", "keilaniemi"]},
    "Munich":   {"linkedin": "Munich, Bavaria, Germany",   "duunitori": null,       "match": ["munich", "münchen", "muenchen", "garching", "unterföhring", "ismaning"]}
  },

  "keywords": {
    "Helsinki": ["software engineer", "software developer", "junior developer", "trainee software", "full stack developer", "machine learning engineer", "devops engineer"],
    "Espoo":    ["software engineer", "software developer", "junior developer", "trainee software", "full stack developer", "machine learning engineer", "devops engineer"],
    "Munich":   ["Werkstudent Software", "Working Student Software", "Software Engineer Intern", "Junior Software Engineer", "Werkstudent Machine Learning", "Werkstudent Full Stack", "Werkstudent DevOps"]
  },

  "sources": {
    "linkedin":  {"enabled": true, "pages_per_query": 3, "posted_within_days": 30},
    "jobly":     {"enabled": true, "pages_per_query": 3, "keywords": ["software", "developer", "ohjelmistokehittäjä", "machine learning", "devops", "trainee"]},
    "duunitori": {"enabled": true, "pages_per_query": 3, "keywords": ["software", "developer", "ohjelmistokehittäjä", "machine learning", "devops", "trainee"]}
  },

  "request_delay_seconds": 1.2,
  "max_detail_fetches_per_run": 600,

  "weights": {"skills": 0.7, "path": 0.3},

  "candidate": {
    "languages": {"english": "C1", "finnish": "A2", "german": "A2"},
    "max_comfortable_years": 2
  },

  "llm": {
    "model": "claude-opus-5",
    "top_n": 25,
    "blend": 0.6
  }
}
